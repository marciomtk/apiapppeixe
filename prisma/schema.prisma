// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Tanque {
  codigo           String    @id
  nome             String
  especie          String
  quantidade       Int
  pesoMedio        Float
  token            String
  ultimoPingEm     DateTime?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt

  // Ração no silo: quantidade abastecida (kg) e quando foi abastecida.
  // O consumo é projetado a partir daí usando o total diário de ração
  // dos horários cadastrados (sem precisar de telemetria do ESP32).
  quantidadeSiloKg Float     @default(0)
  siloAbastecidoEm DateTime?

  horarios         Horario[]
}

model Horario {
  id           Int      @id @default(autoincrement())
  tanqueCodigo String
  hora         String
  peso         Float
  criadoEm     DateTime @default(now())

  tanque       Tanque   @relation(fields: [tanqueCodigo], references: [codigo], onDelete: Cascade)

  @@index([tanqueCodigo])
}
